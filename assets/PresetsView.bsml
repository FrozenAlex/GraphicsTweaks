<vertical preferred-width="110" pad="4" anchor-min-y="1" child-control-height="false" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/RedBrumbler/Quest-BSML-Docs/gh-pages/schema.xsd'>
	<vertical preferred-width="100" child-control-height="false" bg="panel-top" pad="2" pad-top="1" pad-bottom="1">
		<text text="Additional settings" align="Center" bold="true" font-size="3.5" size-delta-y="5" />
		<list-setting text="Sharpening" options="questSharpeningOptions" value="questSharpeningValue" bind-value="true" apply-on-change="true" hover-hint="Off: no compositor sharpening. Normal: standard sharpening. Quality: Meta Quest Super Resolution, most useful at reduced resolution. Does not change resolution or foveation settings." />
	</vertical>
</vertical>
